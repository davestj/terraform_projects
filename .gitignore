# Ignore Terraform state files
*.tfstate
*.tfstate.*

# Ignore .terraform directory
.terraform/

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
terraform.rc

# Ignore sensitive variable files
*.auto.tfvars
*.tfvars.json

# Ignore crash log files
crash.log

# Ignore terraform binary
terraform

